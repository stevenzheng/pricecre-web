datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN_DATA
  ADMIN_FINANCE
  SUPER_ADMIN
}

enum PropertyType {
  OFFICE
  SHOPS
  INDUSTRIAL
}

model User {
  id                    String        @id @default(uuid())
  email                 String?       @unique
  phone                 String?       @unique
  wechatOpenId          String?       @unique
  password              String?       
  role                  Role          @default(USER) 
  vipLevel              Int           @default(0) 
  vipExpireTime         DateTime?     
  purchasedViewCount     Int          @default(0)    
  referralViewCount     Int          @default(3)    
  lifetimeReferralEarned Int          @default(0)    
  myReferralCode        String        @unique 
  createdAt             DateTime      @default(now())
  orders                Order[]
  viewLogs              UserViewLog[]
  referralsGiven        Referral[]    @relation("ReferrerRelation")
  referralReceived      Referral?     @relation("RefereeRelation")
}

model FieldMetadata {
  id            String       @id @default(uuid())
  fieldKey      String       
  fieldName     String       
  fieldType     String       
  unitLabel     String       @default("")
  moduleType    PropertyType 
  isDisplayed   Boolean      @default(true)  
  isLocked      Boolean      @default(true)  
  sortOrder     Int          @default(0)     
  updatedAt     DateTime     @updatedAt

  @@unique([fieldKey, moduleType]) 
}

model Referral {
  id            String   @id @default(uuid())
  referrerId    String   
  refereeId     String   @unique 
  referrer      User     @relation("ReferrerRelation", fields: [referrerId], references: [id], onDelete: Cascade)
  referee       User     @relation("RefereeRelation", fields: [refereeId], references: [id], onDelete: Cascade)
  rewardGranted Boolean  @default(false) 
  createdAt     DateTime @default(now())
}

enum OrderStatus {
  PENDING_PAYMENT   // 0: 待支付
  PAID              // 1: 已支付（额度已发放）
  CANCELLED         // 2: 已取消
  REFUNDED          // 3: 已退款
  REFUNDING         // 4: 退款处理中
  COMPLETED         // 5: 已完成
}

model Order {
  id            String      @id @default(uuid())
  orderNo       String      @unique
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productType   Int         // 1=查看额度, 2=AI对话额度, 3=VIP会员
  amount        Decimal     @db.Decimal(10, 2)
  paymentMethod String      // wechat, alipay, admin_manual
  status        Int         @default(0) // OrderStatus enum
  tradeNo       String?
  paidAt        DateTime?
  cancelledAt   DateTime?
  completedAt   DateTime?
  refundReason  String?
  refundAmount  Decimal?    @db.Decimal(10, 2)
  refundedAt    DateTime?
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productType  String   // view_quota | chat_quota | vip
  productName  String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2)
  totalPrice   Decimal  @db.Decimal(10, 2)
  creditsAdded Int?     // 该商品项授予的额度/次数
  createdAt    DateTime @default(now())
}

model FieldCorrection {
  id          String    @id @default(uuid())
  propertyId  String
  fieldKey    String
  fieldLabel  String?
  oldValue    String
  newValue    String
  reason      String?
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  submittedBy String?
  reviewedBy  String?
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
}

model UserViewLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId  String   
  viewedAt    DateTime @default(now())

  @@unique([userId, propertyId]) 
  @@index([userId, propertyId, viewedAt])
}

model CommercialProperty {
  id                 String       @id @default(uuid())
  projectName        String   
  city               String
  district           String
  rawAddress         String
  propertyType       PropertyType 
  faceRent           Decimal      @db.Decimal(10, 2) 
  area               Int?
  dataSource         String   
  dynamicIndicators  Json         
  confidenceScore    Float        @default(1.0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  agentUpdatedAt     DateTime     

  @@unique([projectName, rawAddress]) 
  @@index([city, propertyType])
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  CRITICAL_MISSING
}

model AgentReviewQueue {
  id                 String       @id
  projectName        String
  city               String
  district           String
  rawAddress         String
  propertyType       PropertyType
  faceRent           Decimal      @db.Decimal(10, 2)
  area               Int?
  dataSource         String
  dynamicIndicators  Json
  status             ReviewStatus @default(PENDING_REVIEW)
  confidenceScore    Float        @default(1.0)
  agentTimestamp     DateTime
  auditLog           String       @default("[]")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([city, propertyType])
}

model ScheduledCrawlJob {
  id                String    @id @default(uuid())
  label             String
  targetUrl         String
  propertyType      PropertyType
  city              String    @default("shanghai")
  district          String    @default("pudong")
  scheduleHour      Int       @default(2)
  scheduleMinute    Int       @default(0)
  isActive          Boolean   @default(true)
  lastRunAt         DateTime?
  lastRunStatus     String    @default("PENDING")
  lastRunError      String?
  lastPipelineCount Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isActive, scheduleHour, scheduleMinute])
}

enum SourceType {
  SSR_HTML
  EXTERNAL_API
  JSON_LD
  RSS_FEED
  FILE_DOWNLOAD
}

model DataSourceRegistry {
  id          String     @id @default(uuid())
  name        String
  url         String
  sourceType  SourceType
  fieldMap    Json       @default("{}")
  crawlConfig Json       @default("{}")
  isActive    Boolean    @default(true)
  priority    Int        @default(0)
  lastRunAt   DateTime?
  lastStatus  String     @default("IDLE")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive, sourceType])
}

model AiAnalysisCache {
  id           String   @id @default(uuid())
  cacheKey     String
  projectName  String
  city         String
  district     String
  propertyType String
  analysisData Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([cacheKey])
}

model UserCredit {
  id               String   @id @default(uuid())
  email            String   @unique
  referralCredits  Int      @default(10) // 新用户默认 10 次查看权益
  purchasedCredits Int      @default(0)
  totalUsed        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
}

model UserChatToken {
  id        String   @id @default(uuid())
  email     String   @unique
  tokens    Int      @default(100) // 新用户默认 100 条 AI 对话额度
  totalUsed Int      @default(0)   // 已使用条数
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model CreditAuditLog {
  id         String   @id @default(uuid())
  email      String
  type       String // add_credits | set_credits | add_tokens | set_tokens | consume_view | consume_chat
  amount     Int
  balance    Int
  adminEmail String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([email])
}
// 把这段追加到你的 prisma/schema.prisma 文件末尾

model VerificationCode {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
